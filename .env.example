# URL publica usada nos metadados, sitemap e dados estruturados.
SITE_URL=http://localhost:3000

# Deve permanecer false em ambientes de teste e preview.
SITE_INDEXABLE=false

# Usado apenas na publicacao legada do GitHub Pages.
PAGES_BASE_PATH=

# Segredos nunca devem ser colocados neste arquivo nem receber o prefixo NEXT_PUBLIC_.
# No Cloudflare, use Secrets e bindings protegidos para valores confidenciais.
